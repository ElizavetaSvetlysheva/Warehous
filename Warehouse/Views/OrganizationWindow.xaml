<Window x:Class="Warehouse.Views.OrganizationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Организации" Height="420" Width="400"
        MinWidth="320"
        WindowStartupLocation="CenterOwner"
        Background="#F0F0F0">

    <Window.Resources>
        <ContextMenu x:Key="OrgContextMenu">
            <MenuItem Header="Новая организация"    Click="Add_Click"/>
            <MenuItem Header="Изменить организацию" Click="Edit_Click"/>
            <MenuItem Header="Удалить организацию"  Click="Delete_Click"/>
        </ContextMenu>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="96"/>
        </Grid.ColumnDefinitions>

        <ListBox x:Name="listOrganizations"
                 Grid.Row="0" Grid.Column="0"
                 ItemsSource="{Binding Organizations}"
                 SelectedItem="{Binding SelectedOrganization}"
                 ContextMenu="{StaticResource OrgContextMenu}"
                 Margin="6,6,3,6"
                 BorderBrush="#ABABAB" BorderThickness="1"
                 Background="White"
                 MouseDoubleClick="listOrganizations_MouseDoubleClick"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding OrgName}" Padding="4,3"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#CCE8FF"/>
                            <Setter Property="Foreground" Value="#1A1A1A"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#E5F3FF"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

        <StackPanel Grid.Row="0" Grid.Column="1"
                    Margin="3,6,6,6" VerticalAlignment="Top">
            <Button Content="OK"      Click="Ok_Click"    Height="28" Margin="0,0,0,6"
                    Background="#0078D7" Foreground="White" BorderBrush="#005A9E"/>
            <Button Content="Закрыть" Click="Close_Click" Height="28"/>
        </StackPanel>

        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#E1E1E1"
                BorderBrush="#ABABAB" BorderThickness="0,1,0,0" Padding="6,4">
            <TextBlock x:Name="txtSelected" Text="Выберите организацию" FontWeight="SemiBold"/>
        </Border>
    </Grid>
</Window>
