<Window x:Class="Warehouse.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ввод данных" Width="400"
        SizeToContent="Height"
        MinHeight="145"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F0F0F0">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="lblPrompt" Text="Введите значение:" Grid.Row="0" Margin="2,2,2,4" TextWrapping="Wrap"/>
        <TextBox x:Name="txtInput" Grid.Row="1" Margin="2" Height="26"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="2" Margin="0,8,0,0">
            <Button Content="OK"     Click="Ok_Click"     Width="80" Height="26"
                    Background="#0078D7" Foreground="White" BorderBrush="#005A9E"/>
            <Button Content="Отмена" Click="Cancel_Click" Width="80" Height="26" Margin="6,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
