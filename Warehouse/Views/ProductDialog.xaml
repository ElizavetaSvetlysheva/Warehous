<Window x:Class="Warehouse.Views.ProductDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Товар" Height="500" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F0F0F0">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="115"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Наименование:" Grid.Row="0" Margin="2,4"/>
        <Border x:Name="borderName" Grid.Row="0" Grid.Column="1" Margin="2,4"
                BorderThickness="1" BorderBrush="Transparent" CornerRadius="2">
            <TextBox x:Name="txtName" BorderThickness="0"/>
        </Border>

        <TextBlock Text="Цена:" Grid.Row="1" Margin="2,4"/>
        <Border x:Name="borderPrice" Grid.Row="1" Grid.Column="1" Margin="2,4"
                BorderThickness="1" BorderBrush="Transparent" CornerRadius="2">
            <TextBox x:Name="txtPrice" BorderThickness="0"/>
        </Border>

        <TextBlock Text="Остаток:" Grid.Row="2" Margin="2,4"/>
        <Border x:Name="borderQuantity" Grid.Row="2" Grid.Column="1" Margin="2,4"
                BorderThickness="1" BorderBrush="Transparent" CornerRadius="2">
            <TextBox x:Name="txtQuantity" BorderThickness="0"/>
        </Border>

        <TextBlock Text="Скидка %:" Grid.Row="3" Margin="2,4"/>
        <Border x:Name="borderDiscount" Grid.Row="3" Grid.Column="1" Margin="2,4"
                BorderThickness="1" BorderBrush="Transparent" CornerRadius="2">
            <TextBox x:Name="txtDiscount" BorderThickness="0"/>
        </Border>

        <TextBlock Text="Категория:" Grid.Row="4" Margin="2,4"/>
        <ComboBox x:Name="cmbCategory" DisplayMemberPath="Name" Grid.Row="4" Grid.Column="1" Margin="2,4"/>

        <TextBlock Text="Производитель:" Grid.Row="5" Margin="2,4"/>
        <ComboBox x:Name="cmbManufacturer" DisplayMemberPath="Name" Grid.Row="5" Grid.Column="1" Margin="2,4"/>

        <TextBlock Text="Поставщик:" Grid.Row="6" Margin="2,4"/>
        <ComboBox x:Name="cmbSupplier" DisplayMemberPath="Name" Grid.Row="6" Grid.Column="1" Margin="2,4"/>

        <TextBlock Text="Фото:" Grid.Row="7" Margin="2,4"/>
        <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" Margin="2,4">
            <TextBox x:Name="txtPhoto" Width="200" IsReadOnly="True" Margin="0"/>
            <Button Content="Выбрать..." Click="SelectPhoto_Click" Width="90" Margin="4,0,0,0"/>
        </StackPanel>

        <TextBlock Text="Превью:" Grid.Row="8" Margin="2,4" VerticalAlignment="Top"/>
        <Image x:Name="imgPreview" Grid.Row="8" Grid.Column="1" Height="90" Width="130"
               Stretch="Uniform" Margin="2,4" HorizontalAlignment="Left"/>

        <StackPanel Grid.Row="9" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,4">
            <Button Content="OK"     Click="Ok_Click"     Width="90" Height="28"
                    Background="#0078D7" Foreground="White" BorderBrush="#005A9E"/>
            <Button Content="Отмена" Click="Cancel_Click" Width="90" Height="28" Margin="6,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
