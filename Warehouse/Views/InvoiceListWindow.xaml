<Window x:Class="Warehouse.Views.InvoiceListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Накладные" Height="540" Width="860"
        WindowStartupLocation="CenterOwner"
        Background="#F0F0F0">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" MinWidth="200"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Grid.Row="0" Margin="6">
            <TextBlock DockPanel.Dock="Top" Text="Список накладных:"
                       FontWeight="SemiBold" Margin="0,0,0,4"/>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,4,0,0">
                <Button Content="Создать"  Click="Add_Click"    Width="80"/>
                <Button Content="Изменить" Click="Edit_Click"   Width="90" Margin="4,0,0,0"/>
                <Button Content="Удалить"  Click="Delete_Click" Width="80" Margin="4,0,0,0"
                        Background="#C0392B" Foreground="White" BorderBrush="#922B21"/>
            </StackPanel>
            <ListView x:Name="listInvoices"
                      SelectionChanged="listInvoices_SelectionChanged">
                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Создать накладную"  Click="Add_Click"/>
                        <MenuItem Header="Изменить накладную" Click="Edit_Click"/>
                        <MenuItem Header="Удалить накладную"  Click="Delete_Click"/>
                    </ContextMenu>
                </ListView.ContextMenu>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Номер" DisplayMemberBinding="{Binding Number}"                              Width="120"/>
                        <GridViewColumn Header="Тип"   DisplayMemberBinding="{Binding Type}"                                Width="100"/>
                        <GridViewColumn Header="Дата"  DisplayMemberBinding="{Binding Date, StringFormat={}{0:dd.MM.yyyy}}" Width="90"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </DockPanel>

        <GridSplitter Grid.Column="1" Grid.Row="0" Width="4"
                      HorizontalAlignment="Center" VerticalAlignment="Stretch"
                      Background="#ABABAB" ShowsPreview="True"/>

        <DockPanel Grid.Column="2" Grid.Row="0" Margin="6">
            <TextBlock DockPanel.Dock="Top" Text="Состав накладной:"
                       FontWeight="SemiBold" Margin="0,0,0,4"/>
            <DataGrid x:Name="gridItems" AutoGenerateColumns="False"
                      CanUserAddRows="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Товар"      Binding="{Binding Product.Name}" Width="*"/>
                    <DataGridTextColumn Header="Количество" Binding="{Binding Quantity}"     Width="90"/>
                    <DataGridTextColumn Header="Цена"       Binding="{Binding Price, StringFormat={}{0:N2}}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <Border Grid.Row="1" Grid.ColumnSpan="3" Background="#E1E1E1"
                BorderBrush="#ABABAB" BorderThickness="0,1,0,0" Padding="8,4">
            <TextBlock x:Name="txtWarehouseName" Text="" FontWeight="SemiBold"/>
        </Border>
    </Grid>
</Window>
