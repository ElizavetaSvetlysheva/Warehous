<Window x:Class="Warehouse.Views.InvoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Накладная" Height="490" Width="580"
        WindowStartupLocation="CenterOwner"
        Background="#F0F0F0">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Номер:" Grid.Row="0" Margin="2,4"/>
        <TextBox x:Name="txtNumber" Grid.Row="0" Grid.Column="1" Margin="2,4"/>

        <TextBlock Text="Тип:" Grid.Row="1" Margin="2,4"/>
        <ComboBox x:Name="cmbType" Grid.Row="1" Grid.Column="1" Margin="2,4">
            <ComboBoxItem Content="Входящая" IsSelected="True"/>
            <ComboBoxItem Content="Исходящая"/>
        </ComboBox>

        <TextBlock Text="Состав:" Grid.Row="2" Margin="2,4"/>
        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="2,4">
            <Button Content="+ Строка" Click="AddRow_Click"    Width="90" Height="24"/>
            <Button Content="✕ Удалить" Click="RemoveRow_Click" Width="90" Height="24" Margin="6,0,0,0"
                    Background="#C0392B" Foreground="White" BorderBrush="#922B21"/>
        </StackPanel>

        <DataGrid x:Name="gridItems" Grid.Row="3" Grid.ColumnSpan="2"
                  AutoGenerateColumns="False" CanUserAddRows="False"
                  CanUserDeleteRows="False" IsReadOnly="False"
                  SelectionMode="Single" Margin="2,4">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Товар" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox x:Name="cmbProduct"
                                      ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=AvailableProducts}"
                                      DisplayMemberPath="Name"
                                      SelectedItem="{Binding SelectedProduct, UpdateSourceTrigger=PropertyChanged}"
                                      Loaded="ProductCombo_Loaded"
                                      BorderThickness="0"
                                      Background="Transparent"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Количество" Binding="{Binding Quantity}" Width="100"/>
                <DataGridTextColumn Header="Цена"       Binding="{Binding Price, StringFormat={}{0:N2}}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="OK"     Click="Ok_Click"     Width="80" Height="26"
                    Background="#0078D7" Foreground="White" BorderBrush="#005A9E"/>
            <Button Content="Отмена" Click="Cancel_Click" Width="80" Height="26" Margin="6,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
